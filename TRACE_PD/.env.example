# TRACE_PD Environment Variables (template)
# Copy to .env and fill in secrets locally:
#   Windows: copy .env.example .env
#
# IMPORTANT:
# - Do not commit your real .env file
# - Rotate any keys that were accidentally committed

# Database (host port 15432 -> container 5432)
TRCPD_DB_USER=trcpd_user
TRCPD_DB_PASS=change_me
TRCPD_DB_NAME=trcpd_db

# Backend JWT secret (change in production)
TRCPD_SECRET=change_me

# Environment
ENVIRONMENT=development

# Azure OpenAI (optional: enables real LLM calls)
# Example endpoint format: https://<resource-name>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# Deployment name configured in Azure OpenAI Studio (e.g., "gpt-4o")
AZURE_OPENAI_DEPLOYMENT=

# Optional extra variable referenced by some codepaths
AZURE_DEPLOYMENT_GPT4O=
